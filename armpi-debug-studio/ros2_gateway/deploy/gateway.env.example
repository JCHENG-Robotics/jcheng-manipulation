# /etc/armpi-gateway/gateway.env  (root:docker, mode 0640; the service runs
# as pi:docker, so it can read this file and reach the Docker socket)
# Read by armpi-gateway.service. Keep the token out of this file.

# Address on the robot to bind. Use the interface that the backend reaches:
#   direct Ethernet : 10.42.0.218   (the only inbound path since 2026-11-18)
#   office WiFi     : not reachable; wlan0 is outbound-only
#   tunnel          : only if the tunnel interface is explicitly trusted
ARMPI_GATEWAY_BIND=10.42.0.218
ARMPI_GATEWAY_PORT=8765
ARMPI_GATEWAY_CONTAINER=ArmPiUltra
ARMPI_GATEWAY_CONTAINER_USER=ubuntu

# Paths are inside the vendor container. The host directory
# /home/pi/docker/tmp/armpi_gateway_deploy is mounted at
# /home/ubuntu/shared/armpi_gateway_deploy.
ARMPI_GATEWAY_DEPLOY_DIR=/home/ubuntu/shared/armpi_gateway_deploy
ARMPI_GATEWAY_TOKEN_FILE=/home/ubuntu/shared/armpi_gateway_deploy/token
ARMPI_GATEWAY_VENDOR_SETUP=/home/ubuntu/ros2_ws/install/setup.bash
# Follow the robot-side ext_cam_node instead of opening /dev/video4.
# Leave empty to fall back to the legacy UVC capture in the gateway.
ARMPI_GATEWAY_AUX_CAMERA_TOPIC=/ext_cam/color/image_raw
