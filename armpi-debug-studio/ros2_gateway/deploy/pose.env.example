# /etc/armpi-gateway/pose.env  (root:docker, mode 0640)
# Read by armpi-gateway-pose.service. Keep the token out of this file.

ARMPI_GATEWAY_POSE_BIND=10.42.0.218
ARMPI_GATEWAY_POSE_PORT=8766
ARMPI_GATEWAY_POSE_CONTAINER=ArmPiUltra
ARMPI_GATEWAY_POSE_CONTAINER_USER=ubuntu

# Paths inside the vendor container. /home/pi/docker/tmp/armpi_gateway_pose
# is mounted at /home/ubuntu/shared/armpi_gateway_pose.
ARMPI_GATEWAY_POSE_DEPLOY_DIR=/home/ubuntu/shared/armpi_gateway_pose
ARMPI_GATEWAY_POSE_TOKEN_FILE=/home/ubuntu/shared/armpi_gateway_deploy/token
ARMPI_GATEWAY_POSE_VENDOR_SETUP=/home/ubuntu/ros2_ws/install/setup.zsh
ARMPI_GATEWAY_POSE_MOTION_CONFIG=/home/ubuntu/shared/armpi_gateway_pose/takeover_limits.json
ARMPI_GATEWAY_POSE_POINTCLOUD_TOPIC=/depth_cam/depth_registered/points
# The read-only 8765 gateway owns the cameras; this instance must not open one.
ARMPI_GATEWAY_POSE_CAMERA_TOPIC=/armpi_pose_camera_off
ARMPI_GATEWAY_POSE_WAIT_S=60
