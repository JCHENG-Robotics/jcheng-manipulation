## Paired trials
PYTHONPATH=ros2_ws/src/armpi_analysis python3 -m armpi_analysis.paired_trials \
  plan --pairs 24 --seed 7 --fixtures grid_A3_center \
  --json-out evidence/phase3/session4_20261117/paired_trials_plan.json
# PLAN pairs=24 entries=48 seed=7

PYTHONPATH=ros2_ws/src/armpi_analysis python3 -m armpi_analysis.paired_trials \
  simulate --pairs 24 --effect-mm 1.0 --noise-mm 0.5 --seed 7 \
  --json-out evidence/phase3/session4_20261117/paired_trials_simulation.json \
  --jsonl-out evidence/phase3/session4_20261117/paired_trials_simulated.jsonl \
  --markdown-out evidence/phase3/session4_20261117/paired_trials_simulation_report.md
# PAIRED_TRIALS pairs=24 records=48 invalid=0
# CONTINUOUS n=24 mean_diff_mm=-1.025 improvement_mm=1.025 ci95=[-1.095, -0.950] sign_p=1.19e-07
# SUCCESS baseline=75.0% intervention=95.8% mcnemar_p=0.1250
# RESULT PASS

PYTHONPATH=ros2_ws/src/armpi_analysis python3 -m armpi_analysis.paired_trials \
  analyze --input evidence/phase3/session4_20261117/paired_trials_simulated.jsonl \
  --seed 7 \
  --json-out evidence/phase3/session4_20261117/paired_trials_analysis.json \
  --markdown-out evidence/phase3/session4_20261117/paired_trials_analysis.md
