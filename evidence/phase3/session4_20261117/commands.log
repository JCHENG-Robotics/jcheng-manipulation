## Build and tests (laptop, Jazzy)
source /opt/ros/jazzy/setup.bash
colcon build --symlink-install --packages-select \
  arm_interfaces armpi_grasp_planner armpi_safety \
  armpi_fiducial_localizer armpi_analysis
# Summary: 5 packages finished

colcon test --packages-select \
  arm_interfaces armpi_grasp_planner armpi_safety \
  armpi_fiducial_localizer armpi_analysis
# Summary: 93 tests, 0 errors, 0 failures, 0 skipped

python3 -m flake8 ros2_ws/src/armpi_analysis tools/phase4 \
  --select=E,F,W --ignore=W503 --max-line-length=79
# rc 0

PYTHONPATH=ros2_ws/src/armpi_analysis python3 -m pytest -q \
  ros2_ws/src/armpi_analysis/test/test_error_budget.py \
  ros2_ws/src/armpi_analysis/test/test_paired_trials.py \
  ros2_ws/src/armpi_analysis/test/test_host_benchmark.py \
  tools/phase2/tests/test_measurement_protocol.py \
  tools/phase4/tests
# 48 passed

## Host/DDS benchmark (read-only)
# No camera:
tools/phase4/run_benchmark.sh evidence/phase3/session4_20261117/no_camera
# Camera running:
TOPICS=/joint_states,/depth_cam/rgb/image_raw,/ros_robot_controller/battery \
  tools/phase4/run_benchmark.sh evidence/phase3/session4_20261117/with_camera

# Camera start for the with_camera run:
ssh -i ~/.ssh/id_ed25519_armpi pi@10.42.0.218 \
  "sudo -n docker exec -d -u ubuntu -w /home/ubuntu ArmPiUltra /bin/zsh -c \
   'source ~/.zshrc >/dev/null 2>&1; \
    exec ros2 launch bringup vision.launch.py > /tmp/vision.log 2>&1'"
# publisher poll: READY (publisher count 1)

# Cross-checks:
bash -c 'source /opt/ros/jazzy/setup.bash; export ROS_DOMAIN_ID=0; \
  ros2 topic hz /depth_cam/rgb/image_raw'
# average rate ~12.0 Hz (cross-host)

sudo -n docker exec -u ubuntu ArmPiUltra /bin/zsh -c \
  'source ~/.zshrc; ROS2CLI_NO_DAEMON=1 ros2 topic hz /depth_cam/rgb/image_raw'
# average rate ~7.0 Hz (in-container)

# Camera stop:
sudo -n docker exec -u ubuntu ArmPiUltra /bin/zsh -c \
  'pkill -f vision.launch.py'
# The launch exits but aurora930_node can be left as a defunct process entry.
# Kill it by exact process name if needed; publisher count returned to 0.
