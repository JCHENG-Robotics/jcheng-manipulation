<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="armpi_ultra">
    <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
    <!--LINKS: When a link is specified, the parent joint of that link (if it exists) is automatically included-->
    <!--JOINTS: When a joint is specified, the child link of that joint (which will always exist) is automatically included-->
    <!--CHAINS: When a chain is specified, all the links along the chain (including endpoints) are included in the group. Additionally, all the joints that are parents to included links are also included. This means that joints along the chain and the parent joint of the base link are included in the group-->
    <!--SUBGROUPS: Groups can also be formed by referencing to already defined group names-->
    <group name="arm">
        <!-- Tip is the grasp tool frame, not just the last actuated link. -->
        <chain base_link="base_link" tip_link="gripper_link"/>
    </group>
    <group name="gripper">
        <joint name="gripper_joint"/>
        <joint name="l_in_joint"/>
        <joint name="l_out_joint"/>
        <joint name="l_joint"/>
        <joint name="r_in_joint"/>
        <joint name="r_out_joint"/>
        <joint name="r_joint"/>
    </group>
    <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->
    <group_state name="init_pose" group="arm">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="0.7309"/>
        <joint name="joint3" value="-1.6127"/>
        <joint name="joint4" value="-1.6591"/>
        <joint name="joint5" value="0"/>
    </group_state>
    <group_state name="reset_servo" group="arm">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="0"/>
        <joint name="joint3" value="0"/>
        <joint name="joint4" value="0"/>
        <joint name="joint5" value="0"/>
    </group_state>
    <!-- Looking horizontally forward in base_link: FK at this state puts the
         camera mount (link4 -> camera_connet_link) at x ~= 0.154 m,
         z ~= 0.282 m, with the camera optical +z axis within 0.1 deg of
         horizontal. The camera is on link4, so joint5 does not change the
         view direction. All five values are inside joint_limits.yaml, so the
         state is a valid arm target. -->
    <group_state name="camera_forward" group="arm">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="0.419"/>
        <joint name="joint3" value="-1.257"/>
        <joint name="joint4" value="-0.709"/>
        <joint name="joint5" value="0"/>
    </group_state>
    <!-- MEASURED 2026-11-18: table-down pose used for the flat-board
         hand-eye fit, the depth-camera table check and the absolute
         table-alignment work. Values are the measured bus-servo pose
         recorded in evidence/calibration/20261118/table_down/. -->
    <group_state name="table_down" group="arm">
        <joint name="joint1" value="0"/>
        <joint name="joint2" value="0.2974"/>
        <joint name="joint3" value="-1.14773"/>
        <joint name="joint4" value="-1.55404"/>
        <joint name="joint5" value="-0.01676"/>
    </group_state>
    <!-- MEASURED 2026-11-18 (no object, supervised): increasing r_joint closes
         the fingers. Mechanical range is r_joint = -0.8378 (open stop) to
         0.0 (closed stop). "open" uses -0.80, about 20 servo counts inside the
         open stop; "close" is the mechanical closed limit and will stall the
         servo when the gripper is empty. See evidence/phase2/onsite_20261118
         and docs/hardware/measured_joint_limits.md. -->
    <group_state name="open" group="gripper">
        <joint name="r_joint" value="-0.80"/>
    </group_state>
    <group_state name="close" group="gripper">
        <joint name="r_joint" value="0.0"/>
    </group_state>
    <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
    <end_effector name="gripper" parent_link="link5" group="gripper" parent_group="arm"/>
    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (considered fixed with respect to the robot)-->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="camera_connet_link" link2="gripper_link" reason="Never"/>
    <disable_collisions link1="camera_connet_link" link2="l_in_link" reason="Never"/>
    <disable_collisions link1="camera_connet_link" link2="l_link" reason="Never"/>
    <disable_collisions link1="camera_connet_link" link2="l_out_link" reason="Never"/>
    <disable_collisions link1="camera_connet_link" link2="link3" reason="Never"/>
    <disable_collisions link1="camera_connet_link" link2="link4" reason="Adjacent"/>
    <disable_collisions link1="camera_connet_link" link2="link5" reason="Never"/>
    <disable_collisions link1="camera_connet_link" link2="r_in_link" reason="Never"/>
    <disable_collisions link1="camera_connet_link" link2="r_link" reason="Never"/>
    <disable_collisions link1="camera_connet_link" link2="r_out_link" reason="Never"/>
    <disable_collisions link1="gripper_link" link2="l_in_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_link" link2="l_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_link" link2="link3" reason="Never"/>
    <disable_collisions link1="gripper_link" link2="link4" reason="Never"/>
    <disable_collisions link1="gripper_link" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="gripper_link" link2="r_in_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_link" link2="r_link" reason="Adjacent"/>
    <disable_collisions link1="l_in_link" link2="l_out_link" reason="Adjacent"/>
    <disable_collisions link1="l_in_link" link2="link3" reason="Never"/>
    <disable_collisions link1="l_in_link" link2="link4" reason="Never"/>
    <disable_collisions link1="l_in_link" link2="link5" reason="Never"/>
    <disable_collisions link1="l_link" link2="l_out_link" reason="Default"/>
    <disable_collisions link1="l_link" link2="link3" reason="Never"/>
    <disable_collisions link1="l_link" link2="link4" reason="Never"/>
    <disable_collisions link1="l_link" link2="link5" reason="Never"/>
    <disable_collisions link1="l_link" link2="r_link" reason="Default"/>
    <disable_collisions link1="l_out_link" link2="link3" reason="Never"/>
    <disable_collisions link1="l_out_link" link2="link4" reason="Never"/>
    <disable_collisions link1="l_out_link" link2="link5" reason="Never"/>
    <disable_collisions link1="l_out_link" link2="r_out_link" reason="Default"/>
    <!-- The two fingers are mechanically independent. The vendor collision
         meshes overlap at some r_joint values, which makes the closed/open
         gripper look self-colliding and blocks arm planning. These are not
         physical finger-finger collisions. -->
    <disable_collisions link1="l_in_link" link2="r_in_link" reason="Never"/>
    <disable_collisions link1="l_in_link" link2="r_link" reason="Never"/>
    <disable_collisions link1="l_in_link" link2="r_out_link" reason="Never"/>
    <disable_collisions link1="l_link" link2="r_in_link" reason="Never"/>
    <disable_collisions link1="l_link" link2="r_out_link" reason="Never"/>
    <disable_collisions link1="l_out_link" link2="r_in_link" reason="Never"/>
    <disable_collisions link1="l_out_link" link2="r_link" reason="Never"/>
    <disable_collisions link1="gripper_link" link2="l_out_link" reason="Never"/>
    <disable_collisions link1="gripper_link" link2="r_out_link" reason="Never"/>
    <disable_collisions link1="l_link" link2="l_in_link" reason="Never"/>
    <disable_collisions link1="r_link" link2="r_in_link" reason="Never"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link3" reason="Never"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link4" reason="Never"/>
    <disable_collisions link1="link2" link2="link5" reason="Never"/>
    <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link5" reason="Never"/>
    <disable_collisions link1="link3" link2="r_in_link" reason="Never"/>
    <disable_collisions link1="link3" link2="r_link" reason="Never"/>
    <disable_collisions link1="link3" link2="r_out_link" reason="Never"/>
    <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="r_in_link" reason="Never"/>
    <disable_collisions link1="link4" link2="r_link" reason="Never"/>
    <disable_collisions link1="link4" link2="r_out_link" reason="Never"/>
    <disable_collisions link1="link5" link2="r_in_link" reason="Never"/>
    <disable_collisions link1="link5" link2="r_link" reason="Never"/>
    <disable_collisions link1="link5" link2="r_out_link" reason="Never"/>
    <disable_collisions link1="r_in_link" link2="r_out_link" reason="Adjacent"/>
    <disable_collisions link1="r_link" link2="r_out_link" reason="Default"/>
</robot>
