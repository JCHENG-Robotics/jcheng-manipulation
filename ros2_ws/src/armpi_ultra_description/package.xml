<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>armpi_ultra_description</name>
  <version>0.0.0</version>
  <description>ArmPi Ultra 5-DoF model, TF frames and vendor-derived meshes</description>
  <maintainer email="maintainer@example.invalid">ubuntu</maintainer>
  <!-- Vendor-derived meshes are used with permission; see THIRD_PARTY_NOTICES.md. -->
  <license>MIT</license>

  <depend>rclpy</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
