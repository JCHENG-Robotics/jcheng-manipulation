+# Measured on 2026-11-18 (tile floor, 1.0 s pulses, ruler): duty 10 % gave
+# 55 mm and duty 20 % gave 110 mm, i.e. 0.0055 m/s per duty unit. The vendor
+# mecanum_2.py scale (v * 100) assumes 0.010 m/s per unit, ~1.8x optimistic.
+# duty = v[m/s] * 182 makes the requested m/s match the measured base speed.
+DUTY_PER_MPS = 182.0
+# Safety cap: the base has no e-stop, so 60 duty (~0.33 m/s on the measured
+# tile scale) is the hard limit regardless of the requested Twist.
+MAX_DUTY = 60.0
+
+
+def watchdog_expired(now_sec, last_cmd_sec, timeout_sec):
+    """Return True when a non-zero command has been silent for too long."""
+    return timeout_sec > 0.0 and (now_sec - last_cmd_sec) >= timeout_sec
